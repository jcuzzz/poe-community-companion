# PoE Community Companion — environment configuration.
# Copy to .env and fill in real values. .env is gitignored; never commit it.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Core Django ----------------------------------------------------------

# Required. 50+ random chars. Never reuse the dev key below.
DJANGO_SECRET_KEY=dev-insecure-key-change-me

# Must stay 0 in production. DEBUG=1 leaks stack traces and settings.
DJANGO_DEBUG=0

# Comma-separated. Must include the public hostname Caddy proxies for.
DJANGO_ALLOWED_HOSTS=poe.example.com,localhost,127.0.0.1

# Comma-separated, scheme required. Needed for CSRF to accept POSTs that
# arrive via Caddy on the public hostname.
DJANGO_CSRF_TRUSTED_ORIGINS=https://poe.example.com

# --- Storage paths (inside the container; matched by compose volumes) ----

DATA_DIR=/app/data
MEDIA_DIR=/app/media

# --- Notifications ---------------------------------------------------------
# Optional. Paste a Discord channel webhook URL to announce new first-place
# claims and contested claims. Leave blank to disable (no calls are made).
# Create one in Discord: Server Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=
# Absolute base URL used for links in notifications.
SITE_BASE_URL=https://poe.example.com

# --- Locale / league -------------------------------------------------------

DJANGO_TIME_ZONE=Australia/Sydney
# Leagues are now DB-backed (created/activated in the admin, see docs/specs/leagues.md).
# LEAGUE_NAME only names the FIRST league created on a fresh install; after that,
# manage leagues in the admin. LEAGUE_START/END are legacy and no longer used
# (each league carries its own start/end dates).
LEAGUE_NAME=Current League
LEAGUE_START=
LEAGUE_END=

# --- Uploads ---------------------------------------------------------------

# 10 MB per image.
MAX_UPLOAD_BYTES=10485760

# --- Roster / character lookup ---------------------------------------------
# The roster uses Path of Building code paste (reliable, both games). Anonymous
# server-side auto-lookup via GGG's legacy API is DISABLED by default: GGG's
# Cloudflare 403s non-browser clients from any server, so it doesn't work here
# (verified 2026 — see docs/research/character-lookup-poe2.md). Leave off unless you
# add a working path (e.g. OAuth). The POE_API_* values only matter if you flip it on.
POE_AUTO_LOOKUP_ENABLED=0
POE_API_BASE=https://www.pathofexile.com
POE_API_TIMEOUT=8
POE_SNAPSHOT_TTL_SECONDS=600
# Contact (email or URL) included in the User-Agent sent to GGG.
POE_API_CONTACT=you@example.com
# Optional full override:
# POE_USER_AGENT=poe-community-companion/1.0 (contact: you@example.com)

# --- TLS / security ---------------------------------------------------------
# Caddy terminates TLS and sends X-Forwarded-Proto; Django trusts that header
# (see settings.py) so these two should stay off/0 — Caddy already redirects
# HTTP->HTTPS and Django re-redirecting behind a proxy can cause loops.
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

DJANGO_LOG_LEVEL=INFO

# Keep the admin off a guessable path. Do not use "admin", and change this
# from the "manage-league" default before going live — it becomes part of
# the site URL, e.g. https://poe.example.com/manage-league/.
DJANGO_ADMIN_PATH=manage-league

# 1 = anyone can browse read-only pages (dashboard, leaderboard, characters,
# strategies, proof images) without logging in. Submitting, voting,
# commenting and editing always need an account. 0 = whole site behind login.
PUBLIC_READ=0

# Interface the app port binds to on the Docker host (see compose.yml).
# Keep 127.0.0.1 when the reverse proxy runs on the same host; set the host's
# LAN IP when it runs elsewhere. Never 0.0.0.0.
APP_BIND=127.0.0.1

# Django (via config/urls.py) serves /media/ itself; there is no Caddy
# file_server for it. Proof images need a login unless PUBLIC_READ=1.
SERVE_MEDIA=1

# --- Backup profile (used by `docker compose run --rm backup`) -----------
# Must point at the mounted ./backups volume. Without this the command
# defaults to BASE_DIR/../backups, which inside the container is the
# unmounted path /backups — the backups would vanish with the container.
BACKUP_DIR=/app/backups

# Run `manage.py seed_achievements` on container start. Leave 0 after the
# first successful deploy; the command is idempotent but the noise is pointless.
SEED_ON_START=0

# Login lockout (django-axes): failures per username + IP before a cooloff.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# Read client IPs from X-Forwarded-For (set by the reverse proxy). Defaults to on
# when DJANGO_DEBUG=0. Turn off if gunicorn is reachable without the proxy.
TRUST_X_FORWARDED_FOR=1
