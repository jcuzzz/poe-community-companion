# Install (on the server, as root):
#   cp deploy/poe-tracker-ninja.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now poe-tracker-ninja.timer
#   systemctl start poe-tracker-ninja.service   # run once now
[Unit]
Description=Squad Achieves (poe-tracker) poe.ninja scarab price refresh
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/poe-tracker
ExecStart=/opt/poe-tracker/deploy/fetch-ninja-prices.sh
