[Unit]
Description=Run PoE Community Companion (poe-community-companion) backup nightly

[Timer]
OnCalendar=*-*-* 03:00:00
# Spread the actual start over a 20-minute window so it doesn't always
# land at exactly 03:00 (avoids collisions with other scheduled jobs).
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
